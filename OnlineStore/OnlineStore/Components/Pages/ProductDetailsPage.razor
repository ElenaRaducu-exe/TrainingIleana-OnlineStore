@page "/dashboard/products/{Id:int}"

@using Microsoft.AspNetCore.Components.Authorization

<MudCard>
    <MudCardMedia Image="@productDTO.ImageUrl" 
                  Height="300"
                  Style="background-size: contain;
                         background-repeat: no-repeat;
                         background-position: center;" />
    <MudCardContent>
        <MudText Align="Align.Center" Typo="Typo.h5">@productDTO.Name</MudText>
        <MudText Align="Align.Center" Typo="Typo.subtitle1">@productDTO.Description</MudText>
        <MudText Align="Align.Center" Typo="Typo.body1">Category: @_category | Brand: @_brand</MudText>
        <MudText Align="Align.Center" Typo="Typo.body2">Stock: @productDTO.Stock | Price: @productDTO.Price</MudText>
    </MudCardContent>

    <AuthorizeView Roles="Admin">
        <MudCardActions>
            <MudButton Variant="Variant.Filled"
                       Style="background-color: #C998ED;"
                       OnClick="@(() => DeleteProduct(productDTO.Id))">
                @Res.Lang.Btn_Delete
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Style="background-color: #C998ED;"
                       OnClick="@(() => EditProduct(productDTO.Id))">
                @Res.Lang.Btn_Edit
            </MudButton>
        </MudCardActions>
    </AuthorizeView>

    <AuthorizeView Roles="Customer">
        <MudButton Variant="Variant.Filled"
                   Style="background-color: #C998ED; margin-top: 15px;"
                   Disabled="@(productDTO.IsActive && productDTO.Stock > 0 ? false : true)"
                   OnClick="@(() => AddToCart(productDTO))">
            @Res.Lang.Btn_AddToCart
        </MudButton>
    </AuthorizeView>

</MudCard>
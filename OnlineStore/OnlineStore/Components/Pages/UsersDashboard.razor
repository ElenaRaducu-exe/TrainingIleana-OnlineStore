@page "/dashboard/users"

@using OnlineStore.DBModels; 
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Admin")]

<h1>UsersDashboard</h1>

<MudTable T="User"
          Items="@UsersList"
          Hover="true"
          Striped="true">

    <HeaderContent>
        <MudTh>Id</MudTh>
        <MudTh>Username</MudTh>
        <MudTh>First Name</MudTh>
        <MudTh>Last Name</MudTh>
        <MudTh>Phone</MudTh>
        <MudTh>Email</MudTh>
        <MudTh>Role</MudTh>
        <MudTh>Activ</MudTh>
        <MudTh>Choose active mode</MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTh>@context.Id</MudTh>
        <MudTh>@context.Username</MudTh>
        <MudTh>@context.FirstName</MudTh>
        <MudTh>@context.LastName</MudTh>
        <MudTh>@context.Phone</MudTh>
        <MudTh>@context.Email</MudTh>
        <MudTh>@(context.RoleId == 1 ? "Customer" : "Admin")</MudTh>
        <MudTh>@(context.IsActive ? "Active" : "Inactive")</MudTh>
        <MudTh>
            <MudButton Variant="Variant.Filled"
                       Style="background-color: #C998ED;"
                       @onclick="@(() => UpdateActiveMode(context.Id))">
                @(context.IsActive ? Res.Lang.Btn_Deactivate : Res.Lang.Btn_Activate)
            </MudButton>
        </MudTh>
    </RowTemplate>

</MudTable>
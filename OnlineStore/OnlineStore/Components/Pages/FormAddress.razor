@page "/place-order/AddressForm/{UserId:int}"

@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Customer")]

<h3>CustomerDetailsForm</h3>

@if (_addressAddedSucces != null)
{
    if (_addressAddedSucces.Value)
    {
        <MudAlert Severity="Severity.Success">@_messageAddedAddressError</MudAlert>
    }
    else
    {
        <MudAlert Severity="Severity.Error">@_messageAddedAddressError</MudAlert>
    }
}

<MudForm>
    <MudTextField @bind-Value="_addressModel.FirstName"
                  Label=@Res.Lang.Label_FirstName
                  Required="true"
                  RequiredError="FirstName is required!"/>

    <MudTextField @bind-Value="_addressModel.LastName"
                  Label=@Res.Lang.Label_LastName
                  Required="true"
                  RequiredError="LastName is required!" />

    <MudTextField @bind-Value="_addressModel.Phone"
                  Label=@Res.Lang.Label_Phone
                  Required="true"
                  RequiredError="Phone is required!" />

    <MudTextField @bind-Value="_addressModel.Street"
                  Label=@Res.Lang.Label_Street
                  Required="true"
                  RequiredError="Street is required!" />

    <MudTextField @bind-Value="_addressModel.StreetNumber"
                  Label=@Res.Lang.Label_StreetNumber
                  Required="true"
                  RequiredError="StreetNumber is required!" />

    <MudTextField @bind-Value="_addressModel.City"
                  Label=@Res.Lang.Label_City
                  Required="true"
                  RequiredError="City is required!" />

    <MudTextField @bind-Value="_addressModel.ZipCode"
                  Label=@Res.Lang.Label_Zipcode
                  Required="true"
                  RequiredError="ZipCode is required!" />

    <MudTextField @bind-Value="_addressModel.BuildingName"
                  Label=@Res.Lang.Label_BuildingName
                  Required="true"
                  RequiredError="BuildingName is required!" />

    <MudTextField @bind-Value="_addressModel.Entrance"
                  Label=@Res.Lang.Label_Entrance
                  Required="true"
                  RequiredError="Entrance is required!" />

    <MudNumericField @bind-Value="_addressModel.FloorNumber"
                     Label=@Res.Lang.Label_FloorNumber
                     Required="true"
                     RequiredError="FloorNumber is required!" />

    <MudNumericField @bind-Value="_addressModel.Apartment"
                     Label=@Res.Lang.Label_Apartment
                     Required="true"
                     RequiredError="Apartment is required!" />
</MudForm>

<MudButton Variant="Variant.Filled"
           Style="background-color: #C998ED;"
           OnClick="@AddAdress">
           @Res.Lang.Btn_Save
</MudButton>
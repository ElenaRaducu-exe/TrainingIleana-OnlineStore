@page "/"

@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.

<MudButton Variant="Variant.Filled" 
           Style="background-color: #C998ED;"
           @onclick = "@TestMedBlazorButton">
    Test MudBlazor
</MudButton>

<br />
<br />
<br />

@if (showMessage)
{
    <p>Instalarea MudBlazor si adaugarea referintelor in proiect au fost efectuate cu succes!</p>
}
else
{
    <p>Instalarea MudBlazor si adaugarea referintelor in proiect NU functioneaza!</p>
}

<MudButton Variant="Variant.Filled"
           Style="background-color: #C998ED;" 
           @onclick="TestAutehntication">
    Test Authentication
</MudButton>

@if (!string.IsNullOrEmpty(_apiResponse))
{
    <MudAlert>
        @_apiResponse
    </MudAlert>
}


@code{
    [Inject]
    private IHttpClientFactory _httpClientFactory { get; set; }

    [Inject]
    private NavigationManager _navigation { get; set; }

    [Inject]
    private ProtectedSessionStorage _sessionStorage { get; set; }

    private bool showMessage = false;
    private string _apiResponse = string.Empty;

    private void TestMedBlazorButton()
    {
        showMessage = true; 
    }

    private async Task TestAutehntication()
    {
        var tokenResult = await _sessionStorage.GetAsync<string>("authToken"); 

        if (!tokenResult.Success || string.IsNullOrEmpty(tokenResult.Value))
        {
            _apiResponse = "Token not found!";
            return; 
        }

        var httpClient = _httpClientFactory.CreateClient();
        httpClient.BaseAddress = new Uri(_navigation.BaseUri);

        httpClient.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", tokenResult.Value);

        var response = await httpClient.GetAsync("api/users/test-auth");

        _apiResponse = await response.Content.ReadAsStringAsync(); 
    }
}
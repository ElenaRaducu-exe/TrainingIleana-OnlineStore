@page "/dashboard/products"

@using Microsoft.AspNetCore.Components.Authorization
@using OnlineStore.Components.ReusableComponnets

@if (ProductsList != null)
{
    @if (_resultAddProductToCart)
    {
        <MudAlert Severity="Severity.Success"
                  Dense="true"
                  Class="my-2">
            @Res.Lang.Alert_AddProductCartSuccessfully
        </MudAlert>
    }

    <MudStack Row ="true">
        <MudNavMenu>
            <MudText Typo="Typo.h6">
                @Res.Lang.Label_FilterProducts
            </MudText>

            <MudTextField T="string"
                          Label=@Res.Lang.Label_ProductName
                          @bind-Value="_filtersModel.Name" />

            <MudSelect T="int?"
                       @bind-Value="_filtersModel.BrandId"
                       Label=@Res.Lang.Label_Brand>
                @foreach (var brand in BrandList)
                {
                    <MudSelectItem value="@((int?)brand.Id)">
                        @brand.BrandName
                    </MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="int?"
                       @bind-Value="_filtersModel.CategoryId"
                       Label=@Res.Lang.Label_Category>
                @foreach (var category in CategoryList)
                {
                    <MudSelectItem value="@((int?)category.Id)">
                        @category.CategoryName
                    </MudSelectItem>
                }
            </MudSelect>

            <MudNumericField T="decimal?"
                             Label=@Res.Lang.Label_PriceFrom
                             @bind-Value="_filtersModel.PriceFrom" />

            <MudNumericField T="decimal?"
                             Label=@Res.Lang.Label_PriceTo
                             @bind-Value="_filtersModel.PriceTo" />

            <MudSelect T="bool?"
                       Label=@Res.Lang.Label_Availability
                       @bind-Value="_filtersModel.AvailableStock">

                <MudSelectItem T="bool?"
                               Value="@null">
                    @Res.Lang.DropdownValue_AllProducts
                </MudSelectItem>

                <MudSelectItem T="bool?"
                               Value="@false">
                    @Res.Lang.DropdownValue_OutOfStock
                </MudSelectItem>

                <MudSelectItem T="bool?"
                               Value="@true">
                    @Res.Lang.DropdownValue_InStock
                </MudSelectItem>
            </MudSelect>

            <MudSelect T="string"
                       Label=@Res.Lang.Label_SortOptions
                       Value="_sortFilter"
                       ValueChanged="@OnSortSelected">
                 <MudSelectItem T="string"
                                Value="@("price:ASC")">
                     @Res.Lang.DropdownValue_Sort_PriceAsc
                 </MudSelectItem>

                <MudSelectItem T="string"
                               Value="@("price:DESC")">
                    @Res.Lang.DropdownValue_Sort_PriceDesc
                 </MudSelectItem>

                <MudSelectItem T="string"
                               Value="@("name:ASC")">
                     @Res.Lang.DropdownValue_Sort_ProductNameAsc
                 </MudSelectItem>

                <MudSelectItem T="string"
                               Value="@("name:DESC")">
                    @Res.Lang.DropdownValue_Sort_ProductNameDesc
                 </MudSelectItem>
            </MudSelect>

            <MudButton Variant="Variant.Filled"
                       Style="background-color: #C998ED; margin-top: 15px;"
                       OnClick="@ApplyFilters">
                @Res.Lang.Btn_ApplyFilters
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Style="background-color: #C998ED; margin-top: 15px;"
                       OnClick="@ResetFilters">
                @Res.Lang.Btn_ResetFilters
            </MudButton>

        </MudNavMenu>

        <MudGrid Spacing="6">
            @if(_isProductListEmpty == true)
            {
                <MudText Typo="Typo.h5">
                    @Res.Lang.Msg_NoProductFoundFilters
                </MudText>
            }

            @foreach (var product in ProductsList)
            {
                <MudItem xs="12" sm="6" md="4" lg="4">
                    <ProductCard ProductModel="@product"
                                 OnSelectedId="@RedirectToProductDetailsPage">

                        <AuthorizeView Roles="Admin">
                            <MudButton Variant="Variant.Filled"
                                       Style="background-color: #C998ED; margin-top: 15px;"
                                       OnClick="@(() => DeleteProduct(product.Id))">
                                @Res.Lang.Btn_Delete
                            </MudButton>

                            <MudSpacer />

                            <MudButton Variant="Variant.Filled"
                                       Style="background-color: #C998ED; margin-top: 15px;"
                                       OnClick="@(() => ChangeActiveMode(product))">
                                @(product.IsActive ? Res.Lang.Btn_Deactivate : Res.Lang.Btn_Activate)
                            </MudButton>

                            <MudSpacer />

                            <MudButton Variant="Variant.Filled"
                                       Style="background-color: #C998ED; margin-top: 15px;"
                                       OnClick="@(() => RedirectToEditForm(product.Id))">
                                @Res.Lang.Btn_Edit
                            </MudButton>
                        </AuthorizeView>

                        <AuthorizeView Roles="Customer">
                            <MudButton Variant="Variant.Filled"
                                       Style="background-color: #C998ED; margin-top: 15px;"
                                       Disabled="@(product.IsActive && product.Stock > 0 ? false : true)"
                                       OnClick="@(() => AddToCart(product))">
                                @Res.Lang.Btn_AddToCart
                            </MudButton>
                        </AuthorizeView>
                    </ProductCard>
                </MudItem>
            }
        </MudGrid>

    </MudStack>

    <div style="margin: 30px auto;text-align: center">
        <MudPagination Count="@_totalPages"
                       Selected="@_pageNumber"
                       SelectedChanged="@OnPageChanged"
                       Color="Color.Primary" 
                       ShowFirstButton="true" 
                       ShowLastButton="true" />
    </div>
}
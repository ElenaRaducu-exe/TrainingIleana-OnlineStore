@page "/dashboard/products"

<MudText>
    Using ProductCard
</MudText>

<MudText>
    @Res.Lang.Label_Test
</MudText>

@if (ProductsList != null) 
{
    @foreach (var product in ProductsList)
    {
        <ProductCard Name = "@product.Name"
                     Description = "@product.Description"
                     Price = "@product.Price"
                     Stock = "@product.Stock"
                     ImageUrl="@product.ImageUrl"
                     Category="@product.Category"
                     Brand="@product.Brand" />
    }
}
@page "/cart/products"
@using OnlineStore.Components.ReusableComponnets

<MudDivider />

<MudText Typo="Typo.h4">@Res.Lang.Label_Cart</MudText>

<MudDivider/>

@if(_cartItems == null || _cartItems.Count() == 0)
{
    <MudText Typo="Typo.h5">
        @Res.Lang.Msg_EmptyCart
    </MudText>

    <MudButton OnClick="@NavigateToProductsPage"
               Variant="Variant.Filled"
               Style="background-color: #C998ED; margin-top: 15px;">
        @Res.Lang.Btn_NavigationToProductsPage
    </MudButton>
}
else
{
    <MudStack Row="true" 
              AlignItems="AlignItems.Start"
              Spacing="10"
              Style="width:100%; margin-top: 30px">
        <div>
            <table>
                <tbody>
                    @foreach (var item in _cartItems)
                    {
                        <CartItemCard CartItemModel="@item"
                                      OnQuantityUpdated="@HandleQuantityUpdated"
                                      OnItemSelected="@RedirectToProductDetailsPage"
                                      OnItemDeleted="@HandleItemDeleted">

                            <MudButton Variant="Variant.Filled"
                                       Style="background-color: #C998ED; margin-top: 15px;"
                                       OnClick="@(() => DeleteCartItem(item.CartId, item.CartItemId))">
                                @Res.Lang.Btn_Delete
                            </MudButton>

                        </CartItemCard>
                    }
                </tbody>
            </table>
        </div>

        <div style="width: 250px;">
            <MudText Typo="Typo.h5">@Res.Lang.Label_cartSummary</MudText>

            <MudDivider />

            <MudText Typo="Typo.body1">Total: @_totalOrderPrice RON</MudText>

            <MudDivider />

            <MudText Typo="Typo.body1">Number products: @_totalCartItems</MudText>

        </div>
    </MudStack>
}
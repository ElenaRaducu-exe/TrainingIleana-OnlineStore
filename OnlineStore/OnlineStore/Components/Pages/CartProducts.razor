@page "/cart/products"
@using OnlineStore.Components.ReusableComponnets

@if(_cartItems == null || _cartItems.Count() == 0)
{
    <MudText Typo="Typo.h5">
        @Res.Lang.Msg_EmptyCart
    </MudText>

    <MudButton OnClick="@NavigateToProductsPage"
               Variant="Variant.Filled"
               Style="background-color: #C998ED; margin-top: 15px;">
        @Res.Lang.Btn_NavigationToProductsPage
    </MudButton>
}
else
{
    <MudGrid Spacing="10">
        <MudItem xs="10">
            @foreach (var item in _cartItems)
            {
                <CartItemCard CartItemModel="@item"
                              OnQuantityUpdated="@HandleQuantityUpdated"
                              OnItemSelected="@RedirectToProductDetailsPage">

                    <MudButton Variant="Variant.Filled"
                               Style="background-color: #C998ED; margin-top: 15px;"
                               OnClick="@(() => DeleteCartItem(item.CartId, item.CartItemId))">
                        @Res.Lang.Btn_Delete
                    </MudButton>

                </CartItemCard>
            }
        </MudItem>

        <MudItem xs="2">
            <MudCard>
                <MudText Typo="Typo.h5">Order Summary</MudText>

                <MudDivider/>

                <MudText Typo="Typo.body1">Total:</MudText>
                <MudText Typo="Typo.h6">@_totalOrderPrice RON</MudText>

                <MudDivider />

                <MudText Typo="Typo.body1">Number products:</MudText>
                <MudText Typo="Typo.h6">@_totalCartItems</MudText>

            </MudCard>
        </MudItem>

    </MudGrid>
}
@page "/dashboard/products/add"
@page "/dashboard/products/edit/{productId:int}"

@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Admin")]

<h3>AddProductFrom</h3>

<MudForm>
    <MudTextField @bind-value="_productModel.Name"          
                  Label=@Res.Lang.Label_ProductName
                  Required="true"
                  RequiredError="Name is required!" />

    <MudTextField @bind-value="_productModel.Description"
                  Label=@Res.Lang.Label_Description
                  Required="true"
                  RequiredError="Description is required!" />

    <MudNumericField @bind-Value="_productModel.Price"
                     Label=@Res.Lang.Label_Price
                     Required="true"
                     RequiredError="Price is required!"
                     Error="@_priceError" />

    <MudNumericField @bind-Value="_productModel.Stock"
                     Label=@Res.Lang.Label_Stock
                     Required="true"
                     RequiredError="Stock is required!"
                     Error="@_stockError" />

    <MudTextField @bind-value="_productModel.ImageUrl"
                  Label=@Res.Lang.Label_ImageURL
                  Required="true"
                  RequiredError="ImageURL is required!" />

    <MudSwitch @bind-Value="_productModel.IsActive"
               Label=@Res.Lang.Label_ActiveStatus
               Color="Color.Success"/>

    <MudSelect T="int"
               @bind-value="_productModel.BrandId"
               Label=@Res.Lang.Label_Brand
               Required="true"
               RequiredError="Brand is required!">
        @foreach (var brand in _brands)
        {
            <MudSelectItem value="@brand.Id">
                @brand.BrandName
            </MudSelectItem>
        }
    </MudSelect>

    <MudSelect T="int"
               @bind-value="@_productModel.CategoryId"
               Label=@Res.Lang.Label_Category
               Required="true"
               RequiredError="Category is required!">
        @foreach (var category in _categories)
        {
            <MudSelectItem value="@category.Id">
                @category.CategoryName
            </MudSelectItem>
        }
    </MudSelect>

    @if (productId == null)
    {
        <MudButton Variant="Variant.Filled"
                   Style="background-color: #C998ED;"
                   OnClick="@AddProduct">
            @Res.Lang.Btn_Add
        </MudButton>
    }
    else
    {
        <MudButton Variant="Variant.Filled"
                   Style="background-color: #C998ED;"
                   OnClick="@(() => EditProduct(_productModel))">
            @Res.Lang.Btn_Edit
        </MudButton>
    }

</MudForm>

@if (!string.IsNullOrEmpty(_priceErrorMessage))
{
    <MudText>@_priceErrorMessage</MudText>
}

@if (!string.IsNullOrEmpty(_stockErrorMessage))
{
    <MudText>@_stockErrorMessage</MudText>
}

@page "/dashboard/products/add"
@page "/dashboard/products/edit/{productId:int}"

@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Admin")]

<h3>AddProductFrom</h3>

<MudForm>
    <MudTextField @bind-value="_productDTO.Name"          
                  Label="Name"
                  Required="true"
                  RequiredError="Name is required!" />

    <MudTextField @bind-value="_productDTO.Description"        
                  Label="Description"
                  Required="true"
                  RequiredError="Description is required!" />

    <MudNumericField @bind-Value="_productDTO.Price"
                     Label="Price"
                     Required="true"
                     RequiredError="Price is required!"
                     Error="@_priceError" />

    <MudNumericField @bind-Value="_productDTO.Stock"
                     Label="Stock"
                     Required="true"
                     RequiredError="Stock is required!"
                     Error="@_stockError" />

    <MudTextField @bind-value="_productDTO.ImageUrl"        
                  Label="ImageURL"
                  Required="true"
                  RequiredError="ImageURL is required!" />

    <MudSwitch @bind-Value="_productDTO.IsActive"
               Label="Active Mode"
               Color="Color.Success"/>

    <MudSelect T="int"
               @bind-value="_productDTO.BrandId"
               Label="Brand"
               Required="true"
               RequiredError="Brand is required!">
        @foreach (var brand in _brands)
        {
            <MudSelectItem value="@brand.Id">
                @brand.BrandName
            </MudSelectItem>
        }
    </MudSelect>

    <MudSelect T="int"
               @bind-value="@_productDTO.CategoryId"
               Label="Category"
               Required="true"
               RequiredError="Category is required!">
        @foreach (var category in _categories)
        {
            <MudSelectItem value="@category.Id">
                @category.CategoryName
            </MudSelectItem>
        }
    </MudSelect>

    @if (productId == null)
    {
        <MudButton Variant="Variant.Filled"
                   Style="background-color: #C998ED;"
                   OnClick="@AddProduct">
            @Res.Lang.Btn_Add
        </MudButton>
    }
    else
    {
        <MudButton Variant="Variant.Filled"
                   Style="background-color: #C998ED;"
                   OnClick="@(() => EditProduct(_productDTO))">
            @Res.Lang.Btn_Edit
        </MudButton>
    }

</MudForm>

@if (!string.IsNullOrEmpty(_priceErrorMessage))
{
    <MudText>@_priceErrorMessage</MudText>
}

@if (!string.IsNullOrEmpty(_stockErrorMessage))
{
    <MudText>@_stockErrorMessage</MudText>
}

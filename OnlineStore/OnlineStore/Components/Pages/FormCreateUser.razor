@page "/user/form"

@using OnlineStore.Models; 
@using Microsoft.AspNetCore.Components.Authorization 

<h3>FormCreateUser</h3>

<MudForm>
    <MudTextField @bind-value="_newUser.Username"
                  Label="Username" 
                  Required="true" 
                  RequiredError="Username is required!" 
                  Error ="@_usernameExistingError"/>

    <MudTextField @bind-value="_newUser.FirstName"
                  Label="FirstName"
                  Required="true" 
                  RequiredError="FirstName is required!" />

    <MudTextField @bind-value="_newUser.LastName"
                  Label="LastName"
                  Required="true" 
                  RequiredError="LastName is required!" />

    <MudTextField @bind-value="_newUser.Phone"
                  Label="Phone"
                  Required="true" 
                  RequiredError="Phone is required!" />

    <MudTextField @bind-value="_newUser.Email"
                  Label="Email" 
                  InputType="InputType.Email"
                  Required="true" 
                  RequiredError="Email is required!" />

    <MudTextField @bind-value="_newUser.Password"
                  Label="Password" 
                  HelperText="Choose a strong password"
                  InputType="InputType.Password"
                  Error="@_passwordMatchError"
                  Required="true" 
                  RequiredError="Password is required!" />

    <MudTextField T="string"
                  @bind-value="_repetedPassword"
                  Label="Password" 
                  HelperText="Repeat the password"
                  InputType="InputType.Password"
                  Error = "@_passwordMatchError"
                  Required="true" 
                  RequiredError="Password is required!" />
     <AuthorizeView Roles="Admin">
        <MudSelect T="UserRoleEnum?"
                   @bind-value="_newUser.Role"
                   Label="Role"
                   Required="true"
                   RequiredError="Role is required!">

            <MudSelectItem T="UserRoleEnum?" 
                           Value="@UserRoleEnum.Customer">
                Customer
            </MudSelectItem>

            <MudSelectItem T="UserRoleEnum?" 
                           Value="@UserRoleEnum.Admin">
                Admin
            </MudSelectItem>
        </MudSelect>
     </AuthorizeView>
    
    <MudButton Variant="Variant.Filled"
               Style="background-color: #C998ED;"
               OnClick="@CreateUser">
        Sign Up
    </MudButton>
</MudForm>

@if (!string.IsNullOrEmpty(_apiResponse))
{
    <MudText>@_apiResponse</MudText>
}
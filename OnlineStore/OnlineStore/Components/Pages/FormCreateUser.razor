@page "/user/form"

@using OnlineStore.Models; 

<h3>FormCreateUser</h3>

<MudForm>
    <MudTextField @bind-value="_newUser.Username"
                  Label="Username" 
                  Required="true" 
                  RequiredError="Username is required!" 
                  Error ="@_usernameExistingError"/>

    <MudTextField @bind-value="_newUser.Email"
                  Label="Email" 
                  InputType="InputType.Email"
                  Required="true" 
                  RequiredError="Email is required!" />

    <MudTextField @bind-value="_newUser.Password"
                  Label="Password" 
                  HelperText="Choose a strong password"
                  InputType="InputType.Password"
                  Error="@_passwordMatchError"
                  Required="true" 
                  RequiredError="Password is required!" />

    <MudTextField T="string"
                  @bind-value="_repetedPassword"
                  Label="Password" 
                  HelperText="Repeat the password"
                  InputType="InputType.Password"
                  Error = "@_passwordMatchError"
                  Required="true" 
                  RequiredError="Password is required!" />

    <MudSelect T="UserRoleEnum"
               @bind-value="_newUser.Role"
               Label="Role" 
               Required="true" 
               RequiredError="Role is required!" >

                   <MudSelectItem Value="@UserRoleEnum.Customer">
                        Customer
                   </MudSelectItem>

                   <MudSelectItem Value="@UserRoleEnum.Admin">
                        Admin
                   </MudSelectItem>
    </MudSelect>

    <MudButton Variant="Variant.Filled"
               Style="background-color: #C998ED;"
               OnClick="@CreateUser">
        Sign Up
    </MudButton>
</MudForm>

@if (!string.IsNullOrEmpty(_apiResponse))
{
    <MudText>@_apiResponse</MudText>
}
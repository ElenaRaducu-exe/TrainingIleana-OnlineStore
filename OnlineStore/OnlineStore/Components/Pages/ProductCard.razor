@page "/dashboard/products/{Id:int}"

<MudCard>
    <MudCardMedia Image="@productDTO.ImageUrl" Height="200" />
    <MudCardContent>
        <MudText Typo="Typo.h5">@productDTO.Name</MudText>
        <MudText Typo="Typo.body1">@productDTO.Description</MudText>
        <MudText Typo="Typo.body1">Category: @productDTO.Category | Brand: @productDTO.Brand</MudText>
        <MudText Typo="Typo.body2">Stock: @productDTO.Stock | Price: @productDTO.Price</MudText>
    </MudCardContent>

    <MudCardActions>
        <MudButton 
            Variant="Variant.Filled"
            Style="background-color: #C998ED;"
            OnClick="@DeleteProduct">
            Delete
        </MudButton>

        <MudButton 
            Variant="Variant.Filled"
            Style="background-color: #C998ED;"
            OnClick="@EditProduct">
            Edit
        </MudButton>
    </MudCardActions>
</MudCard>

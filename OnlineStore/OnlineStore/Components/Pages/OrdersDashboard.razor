@page "/orders-dashboard"

@using OnlineStore.Models.FrontendModels
@using OnlineStore.Components.ReusableComponnets

@if(ordersList != null)
{
    <MudTable T="OrderDetailsModel"
              Items="@ordersList"
              Hover="true"
              Striped="true" 
              Style="white-space: nowrap;"
              OnRowClick="@OrderRowClicked">

        <ToolBarContent>
            <MudText Typo="Typo.h6">Orders</MudText>
        </ToolBarContent>
        
        <HeaderContent>
            <MudTh>Status</MudTh>
            <MudTh>Order Number</MudTh>
            <MudTh>Order Date</MudTh>
            <MudTh>Products Number</MudTh>
            <MudTh>Total Quantity Items</MudTh>
            <MudTh>TotalPrice</MudTh>

            @if (_isAdminUser)
            {
                <MudTh>Username</MudTh>
                <MudTh>FullName</MudTh>
                <MudTh>Email</MudTh>
            }
        </HeaderContent>

        <RowTemplate>
            <OrderDashboardCard OrderModel="@context" 
                                ShowOrderColumnsAdmin="_isAdminUser" />
        </RowTemplate>

    </MudTable>
}
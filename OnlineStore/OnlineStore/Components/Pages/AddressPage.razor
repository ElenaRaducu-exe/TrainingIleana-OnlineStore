@page "/place-order/{UserId:int}"

@using OnlineStore.Components.ReusableComponnets

<h3>AddressPage</h3>

<MudGrid Spacing="10">
    @foreach (var address in addressList)
    {
        <MudItem xs="6">
            <AddressCard addressModel="@address"
                         OnSelectedAddressId="@GetSelectedAddressId"/>
        </MudItem>
    }
</MudGrid>

<MudButton Class="mt-4"
           Variant="Variant.Filled"
           Style="background-color: #C998ED;"
           OnClick="@RedirectToAddressForm">
    @Res.Lang.Btn_NavigateToAddressFrom
</MudButton>

@if (_cartItemsList != null)
{
    @foreach (var item in _cartItemsList)
    {
        <CartItemCard CartItemModel="@item"
                      OnItemSelected="@RedirectToProductDetailsPage" />
    }
}

<MudButton Class="mt-4"
           Variant="Variant.Filled"
           Style="background-color: #C998ED;"
           OnClick="@PlaceOrder">
    @Res.Lang.Btn_PlaceOrder
</MudButton>
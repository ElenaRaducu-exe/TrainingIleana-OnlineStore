<MudCard onclick="@(() => AddressCardClicked(addressModel.AddressId))"
         Style="@(addressModel.AddressId == SelectedAddressId ? "background-color: #befcbe;" : string.Empty)">
    <MudCardHeader>
        <MudText Typo="Typo.h5">Address Details</MudText>
    </MudCardHeader>

    <hr />

    <MudCardContent>
        <MudText Typo="Typo.h6">@addressModel.LastName @addressModel.FirstName - @addressModel.Phone</MudText>

        <hr />

        <MudGrid Spacing="2">
            <MudItem xs="5">
                <MudText Typo="Typo.body1">@Res.Lang.Label_City: </MudText>
                <MudText Typo="Typo.body1">@Res.Lang.Label_Street: </MudText>
                <MudText Typo="Typo.body1">@Res.Lang.Label_StreetNumber: </MudText>
                <MudText Typo="Typo.body1">@Res.Lang.Label_BuildingName: </MudText>
                <MudText Typo="Typo.body1">@Res.Lang.Label_Entrance: </MudText>
                <MudText Typo="Typo.body1">@Res.Lang.Label_FloorNumber: </MudText>
                <MudText Typo="Typo.body1">@Res.Lang.Label_Apartment: </MudText>
            </MudItem>

            <MudItem xs="7"
                     Class="text-end">
                <MudText Class="text-end"
                         Typo="Typo.body1">
                    @addressModel.City
                </MudText>
                <MudText Class="text-end"
                         Typo="Typo.body1">
                    @addressModel.Street
                </MudText>
                <MudText Class="text-end"
                         Typo="Typo.body1">
                    @addressModel.StreetNumber
                </MudText>
                <MudText Class="text-end"
                         Typo="Typo.body1">
                    @addressModel.BuildingName
                </MudText>
                <MudText Class="text-end"
                         Typo="Typo.body1">
                    @addressModel.Entrance
                </MudText>
                <MudText Class="text-end"
                         Typo="Typo.body1">
                    @addressModel.FloorNumber
                </MudText>
                <MudText Class="text-end"
                         Typo="Typo.body1">
                    @addressModel.Apartment
                </MudText>
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>
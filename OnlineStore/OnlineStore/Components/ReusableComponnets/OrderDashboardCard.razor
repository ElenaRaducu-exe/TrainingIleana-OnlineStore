@using OnlineStore.Models.Enums

@if(OrderModel != null)
{
    <MudTd>
        <MudTooltip Text="@OrderStatusExtension.GetDescription(OrderModel.StatusEnum)">
            <MudChip T="string"
                     Class="order-status-label"
                     Size="Size.Small"
                     Variant="Variant.Filled"
                     Style="@( $"--status-color: {OrderStatusExtension.GetColor(OrderModel.StatusEnum)}")">
                <span class="order-label-dot"></span>
                @OrderStatusExtension.GetLabel(OrderModel.StatusEnum) 
            </MudChip>
        </MudTooltip>
    </MudTd>

    <MudTd>
        <MudText Typo="Typo.body2">
            @OrderModel.OrderNumber
        </MudText>
    </MudTd>

    <MudTd>
        <MudText Typo="Typo.body2">
            @OrderModel.OrderDate.ToString("dd/MM/yyyy")
        </MudText>
    </MudTd>

    <MudTd>
        <MudText Typo="Typo.body2">
            @OrderModel.ProductsNumber
        </MudText>
    </MudTd>

    <MudTd>
        <MudText Typo="Typo.body2">
            @OrderModel.TotalQuantityItems
        </MudText>
    </MudTd>

    <MudTd>
        <MudText Typo="Typo.body2">
            @OrderModel.TotalPrice
        </MudText>
    </MudTd>

    @if (ShowOrderColumnsAdmin)
    {
        <MudTd>
            <MudText Typo="Typo.body2">
                @OrderModel.Username
            </MudText>
        </MudTd>

        <MudTd>
            <MudText Typo="Typo.body2">
                @OrderModel.FullName
            </MudText>
        </MudTd>

        <MudTd>
            <MudText Typo="Typo.body2">
                @OrderModel.Email
            </MudText>
        </MudTd>
    }
}

<style>
    .order-status-label {
        background-color: color-mix(in srgb, var(--status-color) 15%, white); 
        color: var(--status-color);
        border-radius: 10px; 
    }

    .order-label-dot{
        border-radius: 50%;
        background-color: var(--status-color);
        width: 8px;
        height: 8px;
        margin-right: 5px;
        display: inline-block;
    }
</style>
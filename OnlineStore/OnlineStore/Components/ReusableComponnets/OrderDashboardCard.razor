@using OnlineStore.Models.Enums

@if(OrderModel != null)
{
    <MudTd>
        <MudTooltip Text="@OrderStatusExtension.GetDescription(OrderModel.StatusEnum)">
            <MudChip T="string"
                     Variant="Variant.Filled"
                     Style="@( $"background-color: {OrderStatusExtension.GetColor(OrderModel.StatusEnum)}; color: white")">
                @OrderStatusExtension.GetLabel(OrderModel.StatusEnum) 
            </MudChip>
        </MudTooltip>
    </MudTd>

    <MudTd>
        <MudText Typo="Typo.body2">
            @OrderModel.OrderNumber
        </MudText>
    </MudTd>

    <MudTd>
        <MudText Typo="Typo.body2">
            @OrderModel.OrderDate.ToString("dd/MM/yyyy")
        </MudText>
    </MudTd>

    <MudTd>
        <MudText Typo="Typo.body2">
            @OrderModel.ProductsNumber
        </MudText>
    </MudTd>

    <MudTd>
        <MudText Typo="Typo.body2">
            @OrderModel.TotalQuantityItems
        </MudText>
    </MudTd>

    <MudTd>
        <MudText Typo="Typo.body2">
            @OrderModel.TotalPrice
        </MudText>
    </MudTd>

    <MudTd>
        <MudText Typo="Typo.body2">
            @OrderModel.Username
        </MudText>
    </MudTd>

    <MudTd>
        <MudText Typo="Typo.body2">
            @OrderModel.FullName
        </MudText>
    </MudTd>

    <MudTd>
        <MudText Typo="Typo.body2">
            @OrderModel.Email
        </MudText>
    </MudTd>
}
﻿<MudCard onclick="@(() => CartItemClicked(CartItemModel.CartItemId))">
    <MudGrid Spacing="20">
        <MudItem xs=3>
            <MudImage Src="@CartItemModel.ImageUrl"
                      Height="200"
                      Width="200"
                      Style="background-size: contain;
                             background-repeat: no-repeat;
                             background-position: center;" />
        </MudItem>
        
        <MudItem xs=3>
            <MudText Typo="Typo.body1">@CartItemModel.ProductName</MudText> 
            <MudText Typo="Typo.body2">@CartItemModel.BrandName - @CartItemModel.CategoryName</MudText>
            <MudText Typo="Typo.body2">@CartItemModel.Description</MudText>
        </MudItem>

        <MudItem xs=2>
            <MudNumericField T="int"
                             Value="@_quantity"
                             Label="Quantity"
                             Required="true"
                             ValueChanged="UpdateQuantity" />
        </MudItem>

        <MudItem xs=2>
            <MudText Typo="Typo.body1">Price: </MudText>
            <MudText Typo="Typo.body1">@CartItemModel.Price RON</MudText>
        </MudItem>

        <MudItem xs=2>
            <MudText Typo="Typo.body1">Total:</MudText>
            <MudText Typo="Typo.body1">@TotalPrice RON</MudText>
        </MudItem>
    </MudGrid>

    @ChildContent

</MudCard>
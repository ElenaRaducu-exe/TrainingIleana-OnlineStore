<tr onclick="@(() => CartItemClicked(CartItemModel.CartItemId))">
    <td>
        <MudImage Src="@CartItemModel.ImageUrl"
                  Height="150"
                  Width="150"
                  Style="background-size: contain;
        background-repeat: no-repeat;
        background-position: center;" />
    </td>

    <td>
        <MudText Typo="Typo.body1">
            @CartItemModel.ProductName
        </MudText>
    </td>
    
    <td>
        <MudText Typo="Typo.body2">
            @CartItemModel.BrandName - @CartItemModel.CategoryName
        </MudText>
    </td>
    
    <td>
        <MudText Typo="Typo.body2">
            @CartItemModel.Description
        </MudText>
    </td>
    
    <td>
        <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Spacing="2">
            <MudButton onclick="@(() => DecreaseQuantity(_quantity))">-</MudButton>
            <MudText Typo="Typo.body2">@_quantity</MudText>
            <MudButton Disabled="@(_availableStock == 0 ? true : false)"
                       onclick="@(() => IncreaseQuantity(_quantity))">+</MudButton>
        </MudStack>
    </td>

    <td>
        <MudText Typo="Typo.body2">Price: </MudText>
        <MudText Typo="Typo.body2">@CartItemModel.Price RON</MudText>
    </td>

    <td>
        <MudText Typo="Typo.body2">Total:</MudText>
        <MudText Typo="Typo.body2">@TotalPrice RON</MudText>
    </td>

    <td>
        @ChildContent
    </td>
</tr>
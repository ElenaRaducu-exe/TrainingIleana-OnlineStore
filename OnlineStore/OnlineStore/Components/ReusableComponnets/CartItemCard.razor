﻿<MudCard>
    <MudGrid Spacing="20">
        <MudItem xs=3>
            <MudImage Src="@ImageUrl"
                      Height="200"
                      Width="200"
                      Style="background-size: contain;
            background-repeat: no-repeat;
            background-position: center;" />
        </MudItem>
        
        <MudItem xs=3>
            <MudText Typo="Typo.body1">@ProductName</MudText>
            <MudText Typo="Typo.body2">@BrandName - @CategoryName</MudText>
            <MudText Typo="Typo.body2">@Description</MudText>
        </MudItem>

        <MudItem xs=2>
            <MudNumericField T="int"
                             Value="@Quantity"
                             Label="Quantity"
                             Required="true"
                             ValueChanged="UpdateQuantity" />
        </MudItem>

        <MudItem xs=2>
            <MudText Typo="Typo.body1">Price per piece: </MudText>
            <MudText Typo="Typo.body1">@Price RON</MudText>
        </MudItem>

        <MudItem xs=2>
            <MudText Typo="Typo.body1">Total:</MudText>
            <MudText Typo="Typo.body1">@TotalPrice RON</MudText>
        </MudItem>
    </MudGrid>

    @ChildContent

</MudCard>
@using Microsoft.AspNetCore.Components.Authorization

<MudNavMenu>
    <MudNavLink Href="/" Match="NavLinkMatch.All">
        Home
    </MudNavLink>

    <MudNavLink Href="/dashboard/products">
        Products
    </MudNavLink>

    <AuthorizeView>
        <MudNavLink Href="/logout">
            Log out
        </MudNavLink>
    </AuthorizeView>

    <AuthorizeView Roles="Admin">
        <MudNavGroup Title="Dashboard" Expanded="true">
            <MudNavLink Href="/dashboard/users">
                Users
            </MudNavLink>

            <MudNavLink Href="/dashboard/products/add">
                Add Product
            </MudNavLink>
        </MudNavGroup>
    </AuthorizeView>

    <AuthorizeView Roles="Customer">
        <MudNavLink Href="/cart/products">
            Cart
        </MudNavLink>
    </AuthorizeView>

    <MudNavLink Href="/user/form">
        Sign Up
    </MudNavLink>

    <MudNavLink Href="/login">
        Log in
    </MudNavLink>
</MudNavMenu>
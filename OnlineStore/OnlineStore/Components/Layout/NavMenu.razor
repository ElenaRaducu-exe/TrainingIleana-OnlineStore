@using Microsoft.AspNetCore.Components.Authorization

<MudNavMenu>
    <MudNavLink Href="/" Match="NavLinkMatch.All">
        Home
    </MudNavLink>

    <MudNavLink Href="/dashboard/products">
        Products
    </MudNavLink>

    <AuthorizeView>
        <Authorized>
            <MudNavLink Href="/logout">
                Log out
            </MudNavLink>
        </Authorized>
        
        <NotAuthorized>
            <MudNavLink Href="/user/form">
                Sign Up / Register 
            </MudNavLink>

            <MudNavLink Href="/login">
                Log in
            </MudNavLink>
        </NotAuthorized>
    </AuthorizeView>

    <AuthorizeView Roles="Admin">
        <MudNavGroup Title="Dashboard" Expanded="true">
            <MudNavLink Href="/dashboard/users">
                Users
            </MudNavLink>

            <MudNavLink Href="/dashboard/products/add">
                Add Product
            </MudNavLink>

            <MudNavLink Href="/user/form">
                Create User Account
            </MudNavLink>
        </MudNavGroup>
    </AuthorizeView>

    <AuthorizeView Roles="Customer">
        <MudNavLink Href="/cart/products">
            Cart
        </MudNavLink>
    </AuthorizeView>
</MudNavMenu>